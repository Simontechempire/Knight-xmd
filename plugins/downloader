const axios = require('axios');
const yts = require('yt-search');
module.exports = [
{ command: ['play','song'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .play Asake Lonely At The Top'); const r=await yts(text); const v=r.videos[0]; if(!v) return reply('Not found'); await reply(`🎵 *${v.title}*\n⏱️ ${v.timestamp} | 👁️ ${v.views}\n🔗 ${v.url}\n\n> Download via .video ${v.url}`); }},
{ command: ['video'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .video <youtube link>'); await reply(`🎬 Searching video...\n🔗 ${text}\n\nUse yt downloader API - link ready: ${text}`); }},
{ command: ['tiktok'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .tiktok <link>'); try{ const {data}=await axios.get(`https://api.tikwm.com/api/?url=${encodeURIComponent(text)}`); const d=data.data; await reply(`🎵 TikTok: ${d.title||''}\n👤 @${d.author?.nickname}\n\nVideo: ${d.play}\nMusic: ${d.music}`); }catch{ await reply('TikTok download failed, try again'); } }},
{ command: ['instagram'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .instagram <link>'); await reply(`📸 Instagram link received\n🔗 ${text}\nFetching... Use web downloader if API fails`); }},
{ command: ['facebook'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .facebook <link>'); await reply(`📘 Facebook link received\n🔗 ${text}`); }},
{ command: ['mediafire'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .mediafire <link>'); try{ const {data}=await axios.get(`https://api.example.com/mediafire?url=${encodeURIComponent(text)}`).catch(()=>({data:null})); await reply(`📁 MediaFire: ${text}\nOpen link to download`); }catch{ await reply(`📁 ${text}`); } }},
{ command: ['apk'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .apk WhatsApp'); await reply(`📱 Searching APK for: ${text}\nCheck: https://apkpure.com/search?q=${encodeURIComponent(text)}`); }},
{ command: ['pinterest'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .pinterest cat'); try{ const {data}=await axios.get(`https://api.unsplash.com/search/photos?query=${encodeURIComponent(text)}&client_id=demo`).catch(()=>({data:null})); await reply(`📌 Pinterest search: ${text}\nhttps://pinterest.com/search/pins/?q=${encodeURIComponent(text)}`); }catch{ await reply('Search failed'); } }},
{ command: ['github'], run: async ({ reply, text }) => { if(!text) return reply('Usage: .github username/repo'); await reply(`🐙 GitHub: https://github.com/${text}\nClone: git clone https://github.com/${text}.git`); }},
];
